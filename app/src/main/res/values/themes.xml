        <item name="windowSplashScreenBackground">@color/arka_plan_koyu</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.EymenTelefon</item>
