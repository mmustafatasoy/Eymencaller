<?xml version="1.0" encoding="utf-8"?>
<!-- DEĞİŞTİRME (AGENTS.md). INTERNET izni bilerek YOKTUR. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <!-- Telefon -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Rehber -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Arama geçmişi -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- Bildirim ve arama ekranı -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".EymenTelefonUygulamasi"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/veri_cikarma_kurallari"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/uygulama_adi"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EymenTelefon.Acilis"
        tools:targetApi="34">

        <!-- Ana ekran + varsayılan telefon uygulaması olabilmek için DIAL filtreleri (zorunlu) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- 08 / 09 / 10 arama ekranları: kilit ekranı üstünde açılır -->
        <activity
            android:name=".gorusme.ui.CallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="com.atasoy.eymentelefon.gorusme"
            android:theme="@style/Theme.EymenTelefon.Arama"
            android:turnScreenOn="true"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- Sistem aramaları bu servise verir (varsayılan telefon uygulaması rolüyle) -->
        <service
            android:name=".gorusme.EymenInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Bildirim eylemleri ve "Hatırlat" alarmı (dışarıya kapalı) -->
        <receiver
            android:name=".gorusme.GorusmeAlicisi"
            android:exported="false" />

        <!-- Telecom'un cevapsız arama bildirimi isteği (varsayılan telefon uygulamasına gönderilir) -->
        <receiver
            android:name=".gorusme.CevapsizAramaAlicisi"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Engellenen numaralar -->
        <service
            android:name=".gorusme.EymenCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>
</manifest>
